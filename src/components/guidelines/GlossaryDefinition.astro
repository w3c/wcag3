---
import { render, type CollectionEntry } from "astro:content";

import { computeTermTitle } from "@/lib/guidelines";

interface Props {
  termEntry: CollectionEntry<"terms">;
}

const { termEntry } = Astro.props;
const { status, synonyms, unusedDefinition } = termEntry.data;
const { Content } = await render(termEntry);
---

<li class="glossary-term" data-status={status}>
  <h3 data-respec-ignore><dfn data-lt={synonyms ? synonyms.join("|") : undefined}  class={unusedDefinition ? "lint-ignore" : undefined}>{computeTermTitle(termEntry)}</dfn></h3>
  <div class="glossary-term--content"><Content /></div>
</li>
