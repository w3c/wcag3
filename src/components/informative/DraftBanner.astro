---
import { isUnpublished } from "@/lib/constants";
---

{
  isUnpublished && (
    <section aria-label="draft preview" role="note" class="default-grid info" tabindex="0">
      <p class="inner">
        This is an unpublished draft that might include content that is not yet approved.
      </p>
    </section>
  )
}
